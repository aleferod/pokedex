# Copy to .env.local for local overrides (git-ignored). Never put secrets here: everything with the
# VITE_ prefix is embedded in the public JavaScript bundle.

# Where the browser calls pokedex-api. Same origin by default (/api is proxied by Vite in
# development and by nginx in the container).
VITE_API_BASE_URL=/api/v1

# Development only: where the Vite dev server proxies /api.
VITE_DEV_API_TARGET=http://localhost:8080

# --- Full stack (docker-compose.full.yml) -------------------------------------------------------
# Read by docker compose only (Vite ignores variables without the VITE_ prefix).

# Placeholders for local use only, the same as pokedex-api's .env.example: they let the demo run as
# is. Anywhere else, set real values; generate a signing secret with:  openssl rand -base64 48
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
DB_NAME=pokedex
DB_USERNAME=pokedex
JWT_TTL=PT1H

# Creates the demo accounts admin/Admin@123 (ADMIN) and trainer/Trainer@123 (USER) and ten local
# Pokémon at startup. The passwords are public: set false for anything reachable by others.
SEED_DEMO_DATA=true

# Upstream catalog and how long the API reuses its answers (ISO-8601).
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
CATALOG_CACHE_TTL=PT1H

# Host ports: the app, and the API (for Swagger UI).
WEB_PORT=8000
API_PORT=8080

# Where to build pokedex-api from: its GitHub repository by default, or a local checkout.
# API_CONTEXT=../pokedex-api
