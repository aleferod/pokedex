# Copy to .env (git-ignored) and adjust:  cp .env.example .env
# Read by docker compose and by the API's "local" profile. Never commit real secrets.

# --- Database (PostgreSQL 16 in docker compose) ---
DB_NAME=pokedex
DB_USERNAME=pokedex
# Placeholder for local development only; use a strong secret anywhere else.
DB_PASSWORD=change-me
# Host port the database is published on; the local profile connects to it.
# 5433 avoids clashing with a PostgreSQL already listening on 5432.
DB_PORT=5433
# Optional full JDBC URL override for the local profile (compose sets its own for the container).
# DB_URL=jdbc:postgresql://localhost:5433/pokedex

# --- Authentication ---
# HMAC secret used to sign access tokens: at least 32 bytes. Generate a real one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
# Access-token lifetime (ISO-8601 duration).
JWT_TTL=PT1H

# --- PokeAPI ---
# Upstream catalog; point it elsewhere for a mirror or a stub.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
# How long catalog pages and details are reused before PokeAPI is asked again (ISO-8601).
CATALOG_CACHE_TTL=PT1H

# --- API ---
# Host port the API is published on (compose) or listens on (local profile).
SERVER_PORT=8080
# Comma-separated browser origins allowed to call /api/** (no wildcards).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
